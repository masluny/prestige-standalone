AnnotationAssertion(AnnotationProperty(rdfs:label) :EndOfMaximumSpeedLimitSign "End of Maximum Speed Limit Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :EndOfMinimumSpeedSign "End of Minimum Speed Sign"@en)
