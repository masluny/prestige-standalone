AnnotationAssertion(AnnotationProperty(rdfs:label) :AxleWeightLimitSign "Axle Weight Limit Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :BuiltUpAreaSign "E5/E6: marks the beginning/end of a built-up area (town entry/exit)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :BuiltUpAreaSign "Built-Up Area Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :BusDriver "Bus Driver"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ChildrenWarningSign "Spanish RGC P-21 / Vienna A12: warns of children crossing or playing near the road."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ChildrenWarningSign "Children Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ChildrenWarningSign "P-21 Niños"@es)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :Colour "A colour used in road sign design (background, border, or symbol)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :Colour "Colour"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ComplementarySign "Not a Section in Vienna Convention but aligned with MSTD dataset."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ComplementarySign "Complementary Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :CrossroadsWarningSign "Warns of an intersection of two roads of equal priority ahead (no subordinate side road indicated)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :CrossroadsWarningSign "Crossroads Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :CrossroadsWithPriorityToTheRightSign "Warns of a crossroads where vehicles coming from the right have priority. Despite the priority semantics it is a warning sign (triangular, red border)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :CrossroadsWithPriorityToTheRightSign "Crossroads With Priority to the Right Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :CrosswindWarningSign "Spanish RGC P-29: warns of a stretch of road exposed to strong lateral (cross) winds."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :CrosswindWarningSign "Crosswind Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :CrosswindWarningSign "P-29 Viento transversal"@es)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :CyclistWarningSign "Spanish RGC P-22: warns of cyclists entering or crossing."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :CyclistWarningSign "Cyclist Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :CyclistWarningSign "P-22 Ciclistas"@es)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :DangerWarningSign "Section A of the Vienna Convention. Triangular signs (Model A^a) or diamond-shaped signs (Model A^b) that warn of hazards ahead. Background white or yellow, border red."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DangerWarningSign "Danger Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :DangerousBendSign "A1 series: warns of a dangerous bend or succession of bends ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DangerousBendSign "Dangerous Bend or Bends Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :DangerousDescentSign "Spanish RGC P-16a / Vienna A2: warns of a steep downhill gradient."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DangerousDescentSign "Dangerous Descent Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DangerousDescentSign "P-16a Bajada con fuerte pendiente"@es)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :DangerousShoulderWarningSign "Spanish RGC P-30: warns of a lateral drop / hazardous shoulder along the carriageway edge."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DangerousShoulderWarningSign "Dangerous Shoulder Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DangerousShoulderWarningSign "P-30 Escalón lateral"@es)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :DeadEndSign "E12: indicates a dead-end road with no through route."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :DeadEndSign "Dead End Sign"@en)
