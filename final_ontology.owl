AnnotationAssertion(AnnotationProperty(rdfs:comment) :MTSD_Label "Provides technical labels from the MTSD used to facilitate alignment between semantic sign concepts and raw dataset image detections."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :MTSD_Label "Mapillary Traffic Sign Dataset (MTSD) Labels"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :MandatorySign "Section D of the Vienna Convention. Circular blue signs with white symbols that prescribe an obligation for road users."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :MandatorySign "Mandatory Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :MaximumSpeedLimitSign "C14: circular sign limiting maximum speed. Number in black on white, red border."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :MaximumSpeedLimitSign "Maximum Speed Limit Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :MotorwayRegulationSign "E1: marks the beginning of a motorway."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :MotorwayRegulationSign "Motorway Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :MyCyclist "appliesTo defines the context of the object
is(...) define the status of the object
xmax, xmin, ymax and ymin draw the exact box around the rider")
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NarrowRoadSign "A4/A5: warns of a road narrowing."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NarrowRoadSign "Narrow Road Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoBicyclesSign "Prohibits cyclists from using this road."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoBicyclesSign "No Bicycles Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoEntrySign "C1: prohibits entry to all vehicles. Red circle with white horizontal bar. Carries no pictogram (the bar is a graphic element, not a symbol/pictogram)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoEntrySign "No Entry Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoHazardousGoodsSign "Prohibits vehicles transporting hazardous materials."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoHazardousGoodsSign "No Hazardous Goods Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoLeftTurnSign "Prohibits turning left at an intersection."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoLeftTurnSign "No Left Turn Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoMotorVehiclesSign "Prohibits all motor vehicles from passing."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoMotorVehiclesSign "No Motor Vehicles Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoOvertakingSign "C16: prohibits overtaking for all motor vehicles."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoOvertakingSign "No Overtaking Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoParkingSign "C18: prohibits parking in the designated area."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoParkingSign "No Parking Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoPedestriansSign "Prohibits pedestrians from this road or path."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoPedestriansSign "No Pedestrians Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoRightTurnSign "Prohibits turning right at an intersection."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoRightTurnSign "No Right Turn Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoStoppingSign "C19: prohibits all stopping and parking."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoStoppingSign "No Stopping Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoTrucksSign "Prohibits lorries and heavy goods vehicles from passing."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoTrucksSign "No Trucks Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :NoUTurnSign "Prohibits U-turns for motor vehicles."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :NoUTurnSign "No U-Turn Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :OneWaySign "E7: indicates a one-way street."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :OneWaySign "One Way Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :OtherColour "Signs with non-standard colours may appear in the MTSD real-world dataset."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :OtherColour "A colour not in the strictly closed colour vocabulary of Vienna Convention Annex 1."@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :OtherDangerWarningSign "A30: a general danger sign for hazards not covered by other categories."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :OtherDangerWarningSign "Other Danger Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :OtherRoadSign "Other Road Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :OtherShape "Signs with non-standard shapes may appear in the MTSD real-world dataset."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :OtherShape "A shape not in the strictly closed shape vocabulary of Vienna Convention Annex 1."@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ParkingSign "E11: indicates an authorised parking area."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ParkingSign "Parking Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PedestrianCrossingInformationSign "Indicates the location of a pedestrian crossing."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PedestrianCrossingInformationSign "Pedestrian Crossing Information Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PedestrianCrossingWarningSign "Spanish RGC P-20: warns of a pedestrian crossing ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PedestrianCrossingWarningSign "P-20 Peatones"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PedestrianCrossingWarningSign "Pedestrian Crossing Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PedestrianZoneSign "Marks a zone restricted to pedestrians."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PedestrianZoneSign "Pedestrian Zone Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityIntersectionLeftSign "P-1b: warns drivers on a priority road of a subordinate (non-priority) side road joining from the left at approximately a right angle."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityIntersectionLeftSign "Priority Intersection (Left) Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityIntersectionRightSign "P-1a: warns drivers on a priority road of a subordinate (non-priority) side road joining from the right at approximately a right angle."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityIntersectionRightSign "Priority Intersection (Right) Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityIntersectionSign "P-1 (Spanish RGC): parent class for warning signs informing the driver, while travelling on a priority road, of an intersection with a subordinate (non-priority) road ahead. Triangular sign with red border (inherits the Triangle shape from DangerWarningSign). Depicts only the road-geometry diagram — carries no pictogram/symbol."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityIntersectionSign "Priority Intersection Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityMergeFromLeftSign "P-1d: warns drivers on a priority road of a subordinate road merging from the left at an acute (oblique) angle."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityMergeFromLeftSign "Priority Merge From Left Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityMergeFromRightSign "P-1c: warns drivers on a priority road of a subordinate road merging from the right at an acute (oblique) angle."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityMergeFromRightSign "Priority Merge From Right Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityOverOncomingTrafficSign "B6: grants priority to the driver over oncoming traffic on a narrow section. Pairs with B5 (Give Way to Oncoming Traffic)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityOverOncomingTrafficSign "Priority Over Oncoming Traffic Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityRoadSign_B3 "B3: indicates the road on which drivers have priority (diamond shape, yellow/white with black border). Carries no pictogram."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityRoadSign_B3 "Priority Road Sign (B3)"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PriorityRouteAtIntersectionSign "Shows the layout of the priority route through an intersection."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PriorityRouteAtIntersectionSign "Priority Route at Intersection Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :PrioritySign "Section B of the Vienna Convention. Signs that establish priority at intersections or road sections."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :PrioritySign "Priority Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ProhibitorySign "Section C of the Vienna Convention. Circular signs that prohibit certain actions or vehicles. White/yellow background, red border, symbol in black (unless otherwise specified)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ProhibitorySign "Prohibitory Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :QuaysideWarningSign "Spanish RGC P-27: warns of an unprotected quay, wharf, or dock edge."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :QuaysideWarningSign "P-27 Muelle"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :QuaysideWarningSign "Quayside Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ReducedVisibilityWarningSign "Spanish RGC P-33: warns of a stretch with reduced visibility due to fog, smoke, mist, or similar."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ReducedVisibilityWarningSign "P-33 Visibilidad reducida"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ReducedVisibilityWarningSign "Reduced Visibility Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RightOfWayPrioritySign "Parent class for signs granting drivers right-of-way on the road they are travelling (diamond shape, yellow/orange background, white border)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RightOfWayPrioritySign "Right-of-Way Priority Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoadBumpSign "Spanish RGC P-15a: warns of a hump, speed bump or ridge in the carriageway."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadBumpSign "P-15a Resalto"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadBumpSign "Road Bump Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoadNarrowsSign "Warns of a carriageway narrowing ahead (symmetric or one-sided; one-sided variants are RoadNarrowsLeftSign and RoadNarrowsRightSign)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadNarrowsSign "Road Narrows Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoadObstructionWarningSign "Spanish RGC P-32: warns of an obstacle or obstruction in the carriageway."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadObstructionWarningSign "P-32 Obstrucción en la calzada"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadObstructionWarningSign "Road Obstruction Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoadSign "The central taxonomic hierarchy organized according to the functional and legal roles defined in the Vienna Convention.

A sign placed beside or above roads to give instructions or provide information to road users, conformant with Part I, Annex 1 of the Vienna Convention on Road Signs and Signals (2006)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadSign "Road Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoadUser "A participant in traffic or road use mentioned in Annex 1."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadUser "Road User"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoadworkSign "Spanish RGC P-18 / Vienna A16: warns of roadworks ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadworkSign "P-18 Obras"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoadworkSign "Road Work Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoundaboutSign "Defined by the Vienna Convention as Sign D, 3. Notifies drivers they must follow the direction indicated by the arrows in a circular movement. 

Note: In Right-Hand Traffic (RHT) countries, circulation is anti-clockwise. Per Article 8, in Left-Hand Traffic (LHT) countries like Ireland, the symbol is mirrored to indicate clockwise circulation."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoundaboutSign "Roundabout Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :RoundaboutWarningSign "Spanish RGC P-4 / Vienna A21: warns of a roundabout intersection ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoundaboutWarningSign "P-4 Intersección con circulación giratoria"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :RoundaboutWarningSign "Roundabout Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :Shape "The geometric morphology of the sign plate, serving as a primary visual identification feature for characterizing sign categories."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :Shape "Shape"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :Shoulder "Arcén"@es)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SlipperyMotorcyclesSign "Variant of the slippery-road warning aimed specifically at motorcyclists (depicts a motorcycle skidding)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SlipperyMotorcyclesSign "Slippery Road (Motorcycles) Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SlipperyRoadSign "General slippery-road warning (water, oil, mud or worn surface). Frost/ice-specific conditions use IcyRoadWarningSign."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SlipperyRoadSign "Slippery Road Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SlipperyRoad_A9 "A9: warns that the road may be slippery."@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SnowChainsSign "Requires vehicles to fit snow chains on driving wheels."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SnowChainsSign "Snow Chains Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SpecialRegulationSign "Section E of the Vienna Convention. Signs that prescribe special regulations for a road or section."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SpecialRegulationSign "Special Regulation Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SteepAscentSign "A3: warns of a steep uphill gradient."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SteepAscentSign "Steep Ascent Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :StopAheadRegulatorySign "Regulatory advance notice that a STOP sign is ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :StopAheadRegulatorySign "Stop Ahead Regulatory Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :StopAheadWarningSign "Warning-side counterpart to the regulatory Stop Ahead sign: triangular danger sign warning of a STOP sign ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :StopAheadWarningSign "Stop Ahead Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :StopHereOnRedOrFlashingLightSign "Indicates the stop line for vehicles when the traffic signal is red or flashing."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :StopHereOnRedOrFlashingLightSign "Stop Here on Red or Flashing Light Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :StopPrioritySign "Parent class for Stop signs (B2a) and related regulatory stop directives. Octagonal, red background, white border."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :StopPrioritySign "Stop Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :StopSign_B2a "B2a: the canonical octagonal STOP sign defined by the Vienna Convention. Red background, white border and lettering."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :StopSign_B2a "Stop Sign (B2a)"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :StopSignalsSign "Indicates the stop line at signal-controlled locations."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :StopSignalsSign "Stop Signals Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SymbolFreeSign "DL-query helper: any road sign that explicitly carries zero pictograms/symbols (e.g. the plain priority-road diamond, give-way triangle, no-entry bar). Use this in DL queries instead of the open-world-broken \"RoadSign and not (hasSymbol some SymbolRoadSign)\" pattern."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SymbolFreeSign "Symbol-Free Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :SymbolRoadSign "A pictogram or symbol displayed on a road sign.

Represents standardized graphic indicators to communicate specific meanings and instructions without relying solely on text."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :SymbolRoadSign "Symbol"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TrafficCongestionWarningSign "Spanish RGC P-31: warns of traffic congestion / queues ahead (typically activated dynamically)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TrafficCongestionWarningSign "P-31 Congestión"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TrafficCongestionWarningSign "Traffic Congestion Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TrafficSignObject "An annotated traffic sign instance detected within an MTSD image. Represents the specific area (bounding box) inside an image where a sign was found."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TrafficSignObject "Traffic Sign Object"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TrafficSignalsWarningSign "Spanish RGC P-3 / Vienna A17: warns of traffic signals ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TrafficSignalsWarningSign "P-3 Semáforos"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TrafficSignalsWarningSign "Traffic Signals Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TramsCrossingWarningSign "Spanish RGC P-6 / Vienna A27: warns of a tram crossing or tram line crossing the carriageway ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TramsCrossingWarningSign "P-6 Cruce de tranvía"@es)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TramsCrossingWarningSign "Trams Crossing Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TruckDriver "Driver of a lorry or heavy goods vehicle."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TruckDriver "Truck Driver"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TurnLeftSign "D1c: compels drivers to turn left at the intersection."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TurnLeftSign "Turn Left Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TurnRightSign "D1b: compels drivers to turn right at the intersection."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TurnRightSign "Turn Right Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :TwoWayTrafficWarningSign "Warns the driver of a transition from one-way to two-way traffic ahead."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :TwoWayTrafficWarningSign "Two-Way Traffic Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :VColours "Colour meanings
        Black: Symbols and text
        Blue: Background of mandatory signs, information signs
        Green: Motorway information signs
        Orange: Temporary roadwork signs (some countries)
        Red: Borders of warning and prohibitory signs
        White: Background of prohibitory/warning signs
        Yellow: Alternative background for warning signs (some countries)"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :VColours "Strictly closed colour vocabulary of Vienna Convention Annex 1."@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :VShape "Shape meanings
            Circle: Prohibitory and mandatory signs
            Inverted triangle: Yield / Give Way sign
            Octagon: STOP sign only
            Rectangle / Square: Information, guidance, and service signs
            Triangle: Warning signs (hazards ahead)

Not Vienna Standard shapes
            Diamond: 4-sided tilted square used in some countries for warning signs 
            Pentagon: 5-sided shape mainly used in the U.S. for school crossing signs"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :VShape "Strictly closed shape vocabulary of Vienna Convention Annex 1."@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :WeightLimitSign "Restricts the maximum gross vehicle weight permitted."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :WeightLimitSign "Weight Limit Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :WidthLimitSign "Restricts the maximum vehicle width permitted."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :WidthLimitSign "Width Limit Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :WildAnimalCrossingSign "Warns of wild animals (deer, boar, etc.) crossing the carriageway."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :WildAnimalCrossingSign "Wild Animal Crossing Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :WindingRoadFirstLeftSign "Warns of a succession of dangerous bends, the first of which is to the left."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :WindingRoadFirstLeftSign "Winding Road (First Left) Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :WindingRoadFirstRightSign "Warns of a succession of dangerous bends, the first of which is to the right."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :WindingRoadFirstRightSign "Winding Road (First Right) Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :YieldPrioritySign "Parent class for Give-Way/Yield signs (inverted triangle, white/yellow background, red border)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :YieldPrioritySign "Give Way (Yield) Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :appliesTo "Indicates which category of road user is subject to this sign."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :appliesTo "Applies to"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :classifiedAs "Maps a raw detection to its formal semantic class.
Links a MTSD traffic sign object annotation to its corresponding ontology class."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :classifiedAs "Classified as"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :depictsObject "Links an image to the abstract concept of a sign."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :depictsObject "Vienna Convention Mapping"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasBackgroundColour "The background/ground colour of the sign panel."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasBackgroundColour "Has background colour"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasBorderColour "The border colour of the sign panel."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasBorderColour "Has border colour"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasHeightLimitValue "The numerical value representing the maximum permissible vehicle height, typically in meters, as shown on the sign."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasHeightLimitValue "Has height limit value"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasMTSDLabel "The Mapillary Traffic Sign Dataset class label string (e.g. \"regulatory--keep-right--g1\")."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasMTSDLabel "Has MTSD label"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasModel "The official Vienna Convention model code of the sign (e.g. \"B2a\", \"A7\", \"C14\")."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasModel "Has model"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasNormalSideLength "The standard measurement for the side or diameter of a sign in metres, as defined by the Vienna Convention."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasNormalSideLength "Has normal side length (m)"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasObject "Links a specific Bounding Box instance to the specific sign detected."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasObject "MSTD Dataset Mapping"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasShape "Associates a road sign with its geometric shape. Functional: each sign has exactly one shape."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasShape "Has shape"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasSpeedLimitValue "The numerical value representing the maximum or minimum speed limit allowed (km/h), as indicated on a speed limit sign."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasSpeedLimitValue "Has speed limit value"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasSymbol "Associates a sign with one or more symbols/pictograms it displays."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasSymbol "Has symbol"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasSymbolColour "The colour of the symbol drawn on a sign."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasSymbolColour "Has symbol colour"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasTextContent "The literal textual string displayed on the road sign, used for city names, supplementary instructions, or street names."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasTextContent "Has text content"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :hasWeightLimitValue "The numerical value representing the maximum permissible vehicle weight or axle load, typically in tonnes."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :hasWeightLimitValue "Has weight limit value"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :imageHeight "The total vertical dimension of the source image, measured in pixels."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :imageHeight "Image height (px)"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :imageWidth "The total horizontal dimension of the source image, measured in pixels."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :imageWidth "Image width (px)"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :isAmbiguous "Is ambiguous"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :isHighway "Is highway sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :isLabeledAs "Maps the convention-based sign to its specific MTSD dataset label."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :isLabeledAs "Is labeled as"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :isOccluded "A boolean flag indicating whether the road sign is partially blocked or obscured by another object in the image."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :isOccluded "Is occluded"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :isOutOfFrame "Is out of frame"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :isPanorama "Is panorama"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :objectKey "A unique alphanumeric identifier assigned to a specific road sign instance or detection within the dataset."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :objectKey "Object key"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :sourceFile "The filename or path of the original image source file where the sign detection was found."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :sourceFile "Source file"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :xmax "The maximum x-coordinate (right side) of the bounding box for a detected road sign object within an image."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :xmax "Bounding box x-max"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :xmin "The minimum x-coordinate (left side) of the bounding box for a detected road sign sign object within an image."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :xmin "Bounding box x-min"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ymax "The maximum y-coordinate (bottom side) of the bounding box for a detected road sign object within an image."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ymax "Bounding box y-max"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :ymin "The minimum y-coordinate (top side) of the bounding box for a detected road sign object within an image."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :ymin "Bounding box y-min"@en)
)
