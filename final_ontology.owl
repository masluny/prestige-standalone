AnnotationAssertion(AnnotationProperty(rdfs:comment) :AccidentAreaWarningSign "Warns of a traffic accident ahead (typically a dynamically activated VMS or temporary deployment)."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :AccidentAreaWarningSign "Accident Area Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:comment) :AirportWarningSign "Spanish RGC P-12: warns of low-flying aircraft near an airport / aerodrome. Distinct from AirportSign which is an OtherDirectionInformationSign pointing to an airport."@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :AirportWarningSign "Airport Warning Sign"@en)
AnnotationAssertion(AnnotationProperty(rdfs:label) :AirportWarningSign "P-12 Aeropuerto"@es)
